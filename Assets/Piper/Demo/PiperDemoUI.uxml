<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <ui:VisualElement name="container" style="flex-grow:1;justify-content:center;align-items:center;background-color:rgba(18,20,24,0.96);padding:20px;">
        <ui:Label text="PIPER LOCAL TEXT-TO-SPEECH" style="font-size:24px;color:#e0e6ed;-unity-font-style:bold;margin-bottom:4px;" />
        <ui:Label name="status-label" text="Inicializace..." style="font-size:13px;color:#50fa7b;margin-bottom:14px;" />
        
        <!-- Voice selector -->
        <ui:VisualElement style="width:720px;margin-bottom:12px;">
            <ui:DropdownField name="voice-dropdown" label="Hlas (Voice):" style="font-size:15px;color:#f8f8f2;" />
        </ui:VisualElement>

        <!-- Audio fine-tuning controls -->
        <ui:VisualElement style="width:720px;background-color:rgba(255,255,255,0.05);padding:10px;border-radius:6px;margin-bottom:14px;">
            <ui:Label text="LADĚNÍ KVALITY A STYLU HLASU:" style="font-size:12px;color:#bd93f9;-unity-font-style:bold;margin-bottom:6px;" />
            
            <ui:Slider name="slider-speed" label="Rychlost (Speed):" low-value="0.8" high-value="1.4" value="1.12" style="font-size:13px;color:#f8f8f2;margin-bottom:4px;" />
            <ui:Slider name="slider-noise" label="Výraznost (Intonation):" low-value="0.5" high-value="1.1" value="0.72" style="font-size:13px;color:#f8f8f2;margin-bottom:4px;" />
            <ui:Slider name="slider-pitch" label="Výška tónu (Pitch):" low-value="0.75" high-value="1.4" value="1.0" style="font-size:13px;color:#f8f8f2;margin-bottom:8px;" />

            <ui:VisualElement style="flex-direction:row;justify-content:space-between;">
                <ui:Button name="btn-preset-natural" text="✨ Přirozený dabing" style="flex-grow:1;height:28px;font-size:12px;margin-right:4px;" />
                <ui:Button name="btn-preset-worms" text="🪱 Červík (Worms)" style="flex-grow:1;height:28px;font-size:12px;margin-right:4px;" />
                <ui:Button name="btn-preset-soldier" text="🎖️ Drsný voják" style="flex-grow:1;height:28px;font-size:12px;" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Text input -->
        <ui:VisualElement style="width:720px;margin-bottom:12px;">
            <ui:Label text="Text k syntéze:" style="font-size:15px;color:#f8f8f2;margin-bottom:4px;" />
            <ui:TextField name="piper-input" value="Příliš žluťoučký kůň úpěl ďábelské ódy." multiline="true" style="height:65px;font-size:17px;" />
        </ui:VisualElement>

        <!-- Quick sample phrases -->
        <ui:VisualElement style="width:720px;flex-direction:row;justify-content:space-between;margin-bottom:14px;">
            <ui:Button name="btn-pangram-cz" text="Pangram CZ" style="flex-grow:1;height:32px;font-size:13px;margin-right:4px;" />
            <ui:Button name="btn-combat-cz" text="Bojová hláška CZ" style="flex-grow:1;height:32px;font-size:13px;margin-right:4px;" />
            <ui:Button name="btn-pangram-en" text="Pangram EN" style="flex-grow:1;height:32px;font-size:13px;margin-right:4px;" />
            <ui:Button name="btn-combat-en" text="Combat Line EN" style="flex-grow:1;height:32px;font-size:13px;" />
        </ui:VisualElement>

        <!-- Action buttons -->
        <ui:VisualElement style="width:720px;flex-direction:row;justify-content:space-between;margin-bottom:12px;">
            <ui:Button name="btn-speak" text="▶ Mluv / Speak" style="flex-grow:2;height:48px;font-size:19px;-unity-font-style:bold;background-color:#2a75d3;color:#ffffff;margin-right:8px;" />
            <ui:Button name="btn-bum" text="Bum! Tohle bude bolet." style="flex-grow:1;height:48px;font-size:15px;" />
        </ui:VisualElement>

        <ui:Label text="Pro stažení dalších hlasů (EN/CZ/SK): Menu Piper -&gt; Download Voices..." style="font-size:12px;color:#6272a4;" />
    </ui:VisualElement>
</ui:UXML>
