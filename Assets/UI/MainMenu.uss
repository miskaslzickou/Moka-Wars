/* Pixel Art Main Menu Stylesheet - Moka Wars Coffee Palette */

* {
    -unity-font: url("project://database/Assets/Thaleah_PixelFont/Materials/ThaleahFat_TTF.ttf");
    -unity-font-definition: url("project://database/Assets/Thaleah_PixelFont/Materials/ThaleahFat_TTF.ttf");
}

.root-container {
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.menu-card {
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    padding: 0;
}

.header-container {
    align-items: center;
    justify-content: center;
    margin-bottom: 34px;
    position: relative;
}

.title-label {
    font-size: 88px;
    -unity-text-align: middle-center;
    letter-spacing: 3px;
    margin: 0;
    padding: 0;
}

.title-front {
    color: #ffde59;
}

.title-shadow {
    position: absolute;
    top: 6px;
    left: 6px;
    width: 100%;
    color: #1a1208;
}

.buttons-container {
    align-items: center;
}

/* Base Pixel Button (Warm Roasted Bean Brown from bean_h.aseprite) */
.pixel-btn {
    width: 440px;
    height: 74px;
    margin-top: 10px;
    margin-bottom: 10px;
    background-color: #382a17;
    border-width: 4px;
    border-color: #5c4526;
    border-radius: 6px;
    color: #fff2df;
    font-size: 34px;
    -unity-text-align: middle-center;
    letter-spacing: 2px;
    border-bottom-width: 8px;
    border-bottom-color: #1c1409;
    transition-duration: 0.1s;
    transition-property: background-color, border-color, translate, color;
}

.pixel-btn:hover {
    background-color: #4c3920;
    border-color: #ff8619;
    border-bottom-color: #261909;
    color: #ffffff;
    translate: 0 -3px;
}

.pixel-btn:active {
    background-color: #241a0d;
    border-color: #ffde59;
    border-bottom-width: 4px;
    translate: 0 4px;
}

/* Primary Button - START GAME (Rich Caramel Roast & Vibrant Amber #FF8619 from sprite) */
.pixel-btn-primary {
    background-color: #7a3a0e;
    border-color: #c4621a;
    border-bottom-color: #3d1a04;
    color: #ffffff;
}

.pixel-btn-primary:hover {
    background-color: #964711;
    border-color: #ff8619;
    border-bottom-color: #4f2105;
    color: #ffffff;
}

/* Quit Button - Red Accent from sprite */
.pixel-btn-danger:hover {
    background-color: #521c16;
    border-color: #ff4d4d;
    border-bottom-color: #240a07;
}

.pixel-btn-back {
    margin-top: 24px;
    width: 260px;
    height: 60px;
    font-size: 28px;
}

/* Modal Panels (Settings & Credits) */
.options-container, .credits-container {
    width: 500px;
    padding: 30px 24px 26px 24px;
    background-color: rgba(31, 23, 13, 0.96);
    border-width: 4px;
    border-color: #543f23;
    border-bottom-width: 8px;
    border-bottom-color: #150f07;
    border-radius: 8px;
    align-items: center;
}

.panel-header-label {
    font-size: 38px;
    color: #ffde59;
    margin-bottom: 20px;
    -unity-text-align: middle-center;
    letter-spacing: 2px;
}

.option-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 90%;
    margin-top: 10px;
    margin-bottom: 10px;
}

.option-label {
    font-size: 20px;
    color: #f7eedf;
    width: 160px;
    letter-spacing: 1px;
}

.pixel-slider {
    flex-grow: 1;
    margin-left: 12px;
}

.pixel-slider .unity-base-slider__dragger {
    background-color: #ff8619;
    border-color: #ffde59;
    border-radius: 4px;
    width: 18px;
    height: 26px;
}

.pixel-slider .unity-base-slider__tracker {
    background-color: #1a1208;
    border-color: #4b371b;
    border-radius: 4px;
    height: 10px;
}

.pixel-toggle {
    margin-left: 12px;
}

.pixel-toggle .unity-toggle__checkmark {
    background-color: #1a1208;
    border-color: #4b371b;
    border-radius: 4px;
    border-width: 2px;
    width: 24px;
    height: 24px;
}

.pixel-toggle:checked .unity-toggle__checkmark {
    background-color: #ff8619;
    border-color: #ffde59;
}

.credit-highlight {
    font-size: 30px;
    color: #ff8619;
    margin-top: 6px;
    letter-spacing: 2px;
}

.credit-text {
    font-size: 22px;
    color: #ebdcd0;
    margin-top: 8px;
}

.credit-subtext {
    font-size: 18px;
    color: #a38975;
    margin-top: 12px;
}

.hidden {
    display: none;
}
